# Place actual TEST credentials only in local .dev.vars or .env (gitignored).
# Cloudflare Pages: configure these under Settings > Variables and Secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Direct business enquiries via Resend and Cloudflare Turnstile.
# Keep all private keys as encrypted Cloudflare Production secrets.
# Sending domain notify.printerresolve.com must be verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=support@printerresolve.com
ENQUIRY_FROM_EMAIL=Printer Resolve Enquiries <enquiries@notify.printerresolve.com>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
